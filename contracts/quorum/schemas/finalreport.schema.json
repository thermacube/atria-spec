{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thermacube.internal/schemas/finalreport.schema.json",
  "title": "FinalReport",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ready_for_coding": {
      "type": "boolean"
    },
    "verdict_summary": {
      "type": "string"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "major"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "summary"
        ]
      }
    },
    "non_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "minor",
              "note"
            ]
          },
          "summary": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "severity",
          "summary"
        ]
      }
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "ready_for_coding",
    "verdict_summary"
  ]
}