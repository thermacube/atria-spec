{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atria Rights Decision",
  "type": "object",
  "required": [
    "decision"
  ],
  "properties": {
    "decision": {
      "enum": [
        "allow",
        "deny",
        "requires_obligation"
      ]
    },
    "subject": {
      "type": "string"
    },
    "object": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "obligations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reason": {
      "type": "string"
    }
  }
}
